{
  "name": "@haarness/browser-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Haarness for Chrome: lets Haarness agents use the user's own Chrome",
  "author": "Haarness",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@haarness/browser-driver": "file:../../packages/browser-driver",
    "effect": "4.0.0-rc.112",
    "lucide-solid": "^1.41.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.0",
    "@types/node": "^22.0.0",
    "devtools-protocol": "0.0.1687809",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-solid": "2.11.14"
  }
}
